{% layout './layouts/layout.liquid'
  , title: "BLOG" %}
{% block head %}
  <link rel="stylesheet" href="/assets/styling/journal.css">
{% endblock %}

{% block %}
  <header>
    <h1 class="main-heading">{{ pageTitle | default: "Welcome!" }}</h1>
  </header>
  <main>
    {% for post in blog reversed %}
      {% render './components/cards/blog-post.liquid'
        , title: post.frontmatter.title
        , link: post.slug
        , date: post.frontmatter.date
        , excerpt: post.frontmatter.excerpt %}
    {% endfor %}
  </main>
{% endblock %}