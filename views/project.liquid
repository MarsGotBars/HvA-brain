---
pagination:
  data: projects.allProjects
  size: 1
  alias: project
permalink: "/portfolio/{{ project.slug }}/"
---
{% layout './layouts/layout.liquid' %}
{% block head %}
  <link rel="stylesheet" href="/assets/styling/project.css">
{% endblock %}
{% block %}
  {% assign currentIndex = pagination.pageNumber %}
  {% assign totalProjects = projects.allProjects.size %}
  {% assign beforeIndex = currentIndex | minus: 1 %}
  {% assign afterIndex = currentIndex | plus: 1 %}
  
  {% comment %} Wrap around if needed {% endcomment %}
  {% if beforeIndex < 0 %}
    {% assign beforeIndex = totalProjects | minus: 1 %}
  {% endif %}
  {% if afterIndex >= totalProjects %}
    {% assign afterIndex = 0 %}
  {% endif %}
  
  {% assign before = projects.allProjects[beforeIndex] %}
  {% assign after = projects.allProjects[afterIndex] %}

  <header>
    <nav>
      <ul>
        <li>
          <a style="--name: {{before.slug}}" href="/portfolio/{{before.slug}}">{{ before.title }}</a>
        </li>
        <li>
          <h1 class="huge" style="--name: {{project.slug}}">{{ project.title }}</h1>
        </li>
        <li>
          <a style="--name: {{after.slug}}" href="/portfolio/{{after.slug}}">{{ after.title }}</a>
        </li>
      </ul>
    </nav>
  </header>

  <main>test {{ project.slug }}</main>
{% endblock %}