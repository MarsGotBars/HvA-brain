{% layout './layouts/grid.liquid' %}
{% block head %}
  <link rel="stylesheet" href="/assets/styling/home.css">
  <script type="module" src="/scripts/mouse-follow.js"></script>
{% endblock %}
{% block grid %}

  <main>
    <header>
      <h1 class="main-heading huge">ABOUT
        <span class="heading-label">MARCIN</span>
      </h1>
    </header>
    <article>
      <h2 class="highlight-block me">
        <span>MARCIN MAGDZIAK</span>
      </h2>
      <span class="extra-info">very creative guy,
        <span class="highlight-block">trust me!</span>
      </span>
      <p>
        <span style="--order: 1;">I AM A
          <span class="underlined semi-bold">DEVELOPER</span>:</span>
      </p>
      <p>
        <span style="--order: 2;">I
          <span class="semi-bold">WRITE</span>
          CODE.</span>
      </p>
      <p>
        <span style="--order: 3;">I DESIGN
          <span class="semi-bold">INTERFACES</span>.</span>
      </p>
      <p>
        <span style="--order: 4;">I CRAFT ANIMATIONS WITH CSS.</span>
      </p>
      <div style="--order: 5.5;" class="group anti">
        <p class="exclude">
          <span style="--order: 5;" class="sentence anti-highlight-block">— NO LIBRARIES,</span>
        </p>
        <p class="exclude">
          <span style="--order: 5.5;" class="anti-highlight-block">NO GIMMICKS.</span>
        </p>
      </div>
      <div class="group">
        <p class="special-case">
          <span style="--order: 6.75;" class="sentence">NO
            <span class="semi-bold">TEMPLATES</span>.</span>
        </p>
        <p class="special-case">
          <span style="--order: 7.5;" class="sentence">NO
            <span class="semi-bold">SHORTCUTS</span>.</span>
        </p>
        <p class="special-case">
          <span style="--order: 8.25;" class="sentence">NO
            <span class="semi-bold">BLOAT</span>.</span>
        </p>
      </div>
      <img
        data-moshable="me"
        style="--reveal: 8.25;"
        src="./assets/img/me.jpeg"
        alt="">
    </article>
  </main>

{% endblock %}