{% layout './layouts/layout.liquid' %}

{% block head %}
<script defer src="/scripts/reveal.js"></script>
<link rel="stylesheet" href="/assets/styling/portfolio.css">
{% endblock %}

{% block %}
<main class="huge">
  <header>
    <h1 class="main-heading huge">
      PORTFOLIO
      <span class="heading-label">LOG</span>
    </h1>
  </header>
  <section class="filtering">
    <h2>VIEW MY LATEST
      <span>{{ projects.allProjects | size | default: 0 }}</span>
      PROJECTS
    </h2>
    <form action="">
      <label>SORT BY:
        <select name="sort">
          <option value="newest">NEWEST</option>
          <option value="oldest">OLDEST</option>
          <option value="fun-factor">FUN FACTOR</option>
          <option value="alphabetical">ALPHABETICAL</option>
        </select>
      </label>
    </form>
  </section>
  <ul class="block-list">
    {% for project in projects.allProjects reversed %}
    {% unless project.condition == "BROKEN" %}

    <li style="--card-number: {{ forloop.index0 }}" class="card" id="{{ project.slug }}">
      <ul class="description-list">
        <li style="--stagger: 0">
          <span class="production-title">YEAR</span>
          <span class="progress-value">{{ project.date_of_production | default: "TBA" }}</span>
        </li>
        <li style="--stagger: 1">
          <span class="progress-title">PROGRESS</span>
          <span class="progress-value">{{ project.progress | default: "UNKNOWN" }}</span>
        </li>
        <li style="--stagger: 2">
          <span class="fun_factor-title">FUN FACTOR</span>
          <span class="fun_factor-value">{{ project.fun_factor | default: "CASUAL" }}</span>
        </li>
      </ul>
      <a href="/portfolio/{{ project.slug }}/" data-triggered="false" style="--h3-length: {{project.title | size}}ch">
        <article>
          <h3 class="split-text">
            {% assign chars = project.title | split: "" %}
            {% assign staggerIndex = 0 %}
            {% assign inWord = false %}

            {% for char in chars %}
              {% comment %} Add a space {% endcomment %}
            {% if char == " " %}
            {% if inWord %}</span>{% endif %}
            <span class="word-space"> </span>
            {% assign inWord = false %}
            {% else %}
            {% unless inWord %}
            <span class="word">
              {% assign inWord = true %}
              {% endunless %}
              <span data-char="{{ char |  upcase }}" data-enhanced="false" style="--stagger: {{ staggerIndex }}">{{ char | upcase }}</span>
              {% assign staggerIndex = staggerIndex | plus: 1 %}
              {% if forloop.last and inWord %}</span>{% endif %}
            {% endif %}
            {% endfor %}


            <span>{% render './partials/icons/arrow/arrow.liquid' %}</span>
          </h3>
          <p>{{ project.short-description }}</p>
        </article>
        {% capture imagePath %}public/assets/img/project-visuals/{{ project.slug }}/{{ project.slug }}-bg.webp{%
        endcapture %}
        {% image imagePath, project.alt %}

      </a>
    </li>
    {% endunless %}
    {% endfor %}
  </ul>
  <footer>
    <a href="/">BACK</a>
  </footer>
</main>
{% endblock %}