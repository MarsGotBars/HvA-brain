<form
  method="POST"
  action="/portfolio"
  data-form="filtering">
  <label for="sort">SORT BY
    <select
      id="sort"
      name="sort"
      data-form="input">
      {% for option in list %}
        {{ option }}
        <option value="{{ option | replace: " ", "-" | downcase }}">
          {{ option | upcase }}
        </option>
      {% endfor %}
    </select>
  </label>
  <label>SEARCH
    <input
      type="text"
      name="search"
      data-form="input">
  </label>
  <button type="submit">
    search
  </button>
</form>