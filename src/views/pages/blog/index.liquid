---
layout: 'default-layout'
title: 'BLOG'
---
<main class="huge">
  <header class="header">
    <h1 class="main-heading huge">
      BLOG
      <span class="heading-label">NEWS</span>
    </h1>
  </header>

  <section class="blog-list">
    {% for post in collections.blog %}
      {% assign item = post.data %}
      <a class="list-item" href="{{ post.url }}">
        <article>
          <h2>
            {{ item.title }}
          </h2>
          <p>
            {{ item.date }}
          </p>

          <footer>
            {% for tag in item.tags %}
              <p>{{ tag }}</p>
            {% else %}
              none
            {% endfor %}
          </footer>
        </article>
      </a>
    {% endfor %}
  </section>

  <footer>
    <a href="/">BACK</a>
  </footer>
</main>
