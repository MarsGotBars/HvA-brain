---
layout: 'default-layout'
title: 'BLOG'
componentStyles:
  - /css/components/BlogList.css
  - /css/components/BlogItem.css
---
<main class="huge">
  <header class="header">
    <h1 class="main-heading huge">
      BLOG
      <span class="heading-label">NEWS</span>
    </h1>
  </header>

  {% render 'organism/BlogList/BlogList', posts: collections.blog %}

  <footer>
    <a href="/">BACK</a>
  </footer>
</main>

<template>
  {% render 'molecule/BlogItem/BlogItem', href: post.url, item: item %}
</template>
