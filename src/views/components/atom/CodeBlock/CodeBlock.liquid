<code class="CodeBlock" data-type="{{type}}">
  {% if managers %}
    <span class="cmd-managers">
      {% for mgr in managers %}
        <span
          class="cmd-group"
          data-manager="{{ mgr }}"
          {% unless forloop.first %}
            inert
          {% endunless %}
        >
          <span class="cmd-manager">
            {{- mgr -}}
          </span>
          <span class="cmd-rest">
            {{- cmd -}}
          </span>
        </span>
        {% render 'atom/CopyButton/CopyButton', cmd: cmd, mgr: mgr %}
      {% endfor %}
    </span>

  {% else %}
    {{ cmd }}
    {% render 'atom/CopyButton/CopyButton', cmd: cmd %}
  {% endif %}
</code>
