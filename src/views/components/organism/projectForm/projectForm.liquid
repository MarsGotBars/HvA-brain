<form
  class="ProjectForm"
  method="POST"
  action="/portfolio"
  data-form="filtering">
  <label>
    <span>SEARCH</span>
    <input
      type="text"
      name="search-name"
      data-form="input">
  </label>
  <div class="grouper">

    <label>
      <span>SORTED BY</span>
      <select name="sort-general" data-form="input">
        {% for option in list %}
          {{ option }}
          <option value="{{ option | replace: " ", "-" | downcase }}">
            {{ option }}
          </option>
        {% endfor %}
      </select>
    </label>
    <button
      type="button"
      data-form="button"
      name="sort-invert">invert sort</button>
  </div>
  <button type="submit" data-form="submit">
    search
  </button>
</form>