<code class="CodeBlock" containertiming="copyBlock" data-type="{{type}}">
  {% if managers %}
    <span class="cmd-managers">
      {% for mgr in managers %}
        <span class="cmd-pair">
          <span
            class="cmd-group cmd-text"
            data-manager="{{ mgr }}"
            {% unless forloop.first %}
              inert
            {% endunless %}
          >
            <span class="cmd-manager">
              {{- mgr -}}
            </span>
            <span class="cmd-rest">
              {{- cmd -}}
            </span>
          </span>
          {% render 'molecule/CopyButton/CopyButton', cmd: cmd, mgr: mgr %}
        </span>
      {% endfor %}
    </span>

  {% else %}
    <span class="cmd-text">
      {{ cmd }}
    </span>
    {% render 'molecule/CopyButton/CopyButton', cmd: cmd %}
  {% endif %}
  <aside containertiming="steamhappy" class="anchored-aside ff-p">
    <p>Click to copy</p>
  </aside>
</code>
