<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles/general.css" />
    <title>{{title |  default: "( M ‿ M )"}} ( M ‿ M )</title>
    
    {% if specificStyle %}
        <link rel="stylesheet" href="/styles/pages/{{specificStyle}}.css">
    {% endif %}
    
    <!-- Auto-detected component styles -->
    {% if componentStyles %}
        {% for style in componentStyles %}
        <link rel="stylesheet" href="{{ style }}">
        {% endfor %}
    {% endif %}

    <!-- Auto-detected component scripts -->
    {% if componentScripts %}
        {% for script in componentScripts %}
        <script src="{{ script }}" type="module"></script>
        {% endfor %}
    {% endif %}
    
    <!-- Page-specific styles -->
    {% if pageStyles %}
        {% for style in pageStyles %}
        <link rel="stylesheet" href="{{ style }}">
        {% endfor %}
    {% endif %}
    
    <!-- Page-specific scripts in head -->
    {% if pageScripts.head %}
        {% for script in pageScripts.head %}
        <script src="{{ script }}" type="module"></script>
        {% endfor %}
    {% endif %}